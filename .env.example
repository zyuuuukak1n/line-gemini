# ==============================================================================
# LINE Messaging API Configuration
# ==============================================================================
# LINE Developersコンソール > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Developersコンソール > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE Developersコンソール > チャネル基本設定 > あなたのユーザーID (またはBotのユーザーID)
# メンション判定の精度向上のために指定推奨（未指定でもis_self判定および全メンション検知で動作します）
LINE_BOT_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# Google Gemini API Configuration
# ==============================================================================
# Google AI Studioで発行したAPIキー
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するGeminiモデル（デフォルト: gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Security & Access Control (Whitelist)
# ==============================================================================
# 許可するLINEグループID/ルームID（カンマ区切りで複数指定可能。空の場合は全グループで受付）
# ※Botをグループに招待した際、サーバーログに "groupId=Cxxxxxxxx" が出力されます
ALLOWED_GROUP_IDS=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Cyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 許可するLINEユーザーID（1対1トーク用。カンマ区切りで複数指定可能。空の場合は全ユーザーで受付）
ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# Server & Logging Configuration
# ==============================================================================
PORT=8000
LOG_LEVEL=INFO
